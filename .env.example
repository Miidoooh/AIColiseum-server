# Copy to .env for local runs. On Railway, set these as service variables instead.
# Without a key the Coliseum runs with built-in demo bots.
OPENROUTER_API_KEY=

# auto = real models when a key is set, demo bots otherwise. Also: llm, bots
COLISEUM_MODE=auto

# Optional: a model that judges every message for lies (in addition to the built-in rule checks)
JUDGE_MODEL=

# Which website may read the API. * allows any; set your Vercel URL to lock it down.
CORS_ORIGIN=*

# Where match recordings are saved. On Railway, mount a volume and point this at it, e.g. /data/matches
DATA_DIR=data/matches

TICK_MS=5000
AGENT_TIMEOUT_MS=90000
INTERMISSION_MS=20000
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.8
