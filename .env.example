# Copy to .env and fill in. The game server needs a key; without one it stays offline.
OPENROUTER_API_KEY=

# Optional: a model that judges every message for lies (in addition to the built-in rule checks)
JUDGE_MODEL=

# Minimum wall-clock time per round, so viewers can follow along
TICK_MS=5000
AGENT_TIMEOUT_MS=90000
INTERMISSION_MS=20000
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.8
PORT=8787

# Server: which website may read the API. * allows any; set your Vercel URL to lock it down.
CORS_ORIGIN=*

# Where match recordings are saved. On Railway, mount a volume and point this at it, e.g. /data/matches
DATA_DIR=data/matches
